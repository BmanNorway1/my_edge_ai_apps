/ {
	chosen {
		ncs,control-output-uart = &uart30;
	};

	aliases {
        ww-out = &ww_pin;
    };
	ww_output {
		compatible = "gpio-leds"; // Reuse the gpio-leds compatible to ensure the system understands this is a GPIO output
    	ww_pin: ww_pin {
			gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>; 
			label = "Wake word output";
		};
    };
};

&uart30 {
	status = "okay";
};

&pinctrl {
	pdm20_default_alt: pdm20_default_alt {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 1, 4)>,
				<NRF_PSEL(PDM_DIN, 1, 5)>;
		};
	};
};

dmic_dev: &pdm20 {
	status = "okay";
	pinctrl-0 = <&pdm20_default_alt>;
	pinctrl-names = "default";
	clock-source = "PCLK32M";
};

&axon {
	status = "okay";
};
